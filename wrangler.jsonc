{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rent",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.html", "**/*.css", "**/*.txt"],
			"fallthrough": true
		}
	],
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"vars": {
		// 仅允许已部署的营销官网跨站提交购物车订单。
		"PUBLIC_WEB_ORIGIN": "https://www.geekslope.de5.net"
	},
	"services": [
		{
			"binding": "DELIVERY_SERVICE",
			"service": "rent-web",
			"remote": true
		}
	],
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	"d1_databases": [
		{
			"binding": "RENT",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93"
		},
	],
	"triggers": {
		// One trigger dispatches minute, 15-minute, hourly and daily batches
		// using the event's scheduled UTC time (daily maintenance at 00:00).
		"crons": ["* * * * *"]
	},
	// "ai": {
	//   "binding": "AI"
	// },
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}
